{
  "name": "dup-checker",
  "private": true,
  "version": "0.1.0",
  "description": "Duplicate file detection application for images and videos using perceptual hashing",
  "author": {
    "name": "Tawfiqul Bari",
    "email": "tawfiqul@example.com"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron-vite dev",
    "build": "vite build",
    "build:electron": "electron-vite build && electron-builder",
    "build:electron:win": "electron-vite build && electron-builder --win",
    "build:electron:linux": "electron-vite build && electron-builder --linux",
    "build:electron:mac": "electron-vite build && electron-builder --mac",
    "preview": "vite preview",
    "preview:electron": "electron-vite preview"
  },
  "dependencies": {
    "node-av": "^3.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@webgpu/types": "^0.1.66",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "electron-vite": "^2.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.dupchecker.app",
    "productName": "Dup-Checker",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility"
    }
  }
}
